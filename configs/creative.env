# === CORE ===
MODEL="large-v3"
USE_QUANTIZED="true"

# === PERFORMANCE ===
THREADS=8
PROCESSORS=1
BEAM_SIZE=2            # Low beam size reduces looping

# === ACCURACY & HALLUCINATION CONTROL ===
ENTROPY_THOLD=2.8      # Loose
LOGPROB_THOLD=-2.0     # Loose
AUDIO_CTX=0
SUPPRESS_NST="true"

# === FORMATTING & OUTPUT ===
LANGUAGE="auto"
TRANSLATE="false"
NO_FALLBACK="false"
NO_TIMESTAMPS="false"
TINYDIARIZE="false"

# === VISUALS ===
PRINT_COLORS="true"
PRINT_SPECIAL="false"

# === PROMPT ===
INITIAL_PROMPT="Transcribe naturally. Do not get stuck in loops."
