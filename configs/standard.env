# ==============================================================================
# WHISPER.CPP ENVIRONMENT CONFIGURATION (standard.env)
# ==============================================================================

# === CORE ===
WHISPER_DIR="$HOME/whisper.cpp"
MODEL="large-v3-turbo-q5_0"               # e.g., base, small, medium, large-v3
USE_QUANTIZED="true"           # Custom flag for your pipeline (true/false)

# === PERFORMANCE & HARDWARE ===
THREADS=8                      # Number of computational threads to use
PROCESSORS=1                   # Number of context processors to use
NO_GPU="false"                 # true = Force CPU-only execution
FLASH_ATTN="false"             # true = Enable flash attention (requires supported GPU)
OV_E_DEVICE="CPU"              # OpenVINO encoder device target (CPU, GPU, NPU)

# === AUDIO TIMING & CUTOFFS ===
OFFSET_T=0                     # Time offset in milliseconds to start reading audio
OFFSET_N=0                     # Segment index offset starter
DURATION=0                     # Duration of audio to process in ms (0 = entire file)
MAX_LEN=0                      # Maximum segment length in characters (0 = no limit)
SPLIT_ON_WORD="false"          # true = Split segments on words rather than tokens

# === SAMPLING & HEURISTICS ===
TEMPERATURE="0.00"             # Initial sampling temperature (0.0 = deterministic)
TEMPERATURE_INC="0.20"         # Temperature fallback step increment
BEST_OF=5                      # Candidate sequences to keep during non-deterministic sampling
BEAM_SIZE=7                    # Beam size for the decoding beam search #Old value 5
AUDIO_CTX=0                    # Audio context size (0 = use entire buffer)
MAX_CONTEXT=-1                 # Max text context tokens to store (-1 = no limit)

# === ACCURACY & HALLUCINATION CONTROL ===
ENTROPY_THOLD="2.51"           # Lower is stricter. Fails if text looks like random gibberish (2.2 - 2.8) # Old value 2.4
LOGPROB_THOLD="-1.53"          # Higher (closer to 0) is stricter. Fails if confidence drops (-0.8 to -2.0) # Old value -1
NO_SPEECH_THOLD="0.46"         # Silence probability threshold; cuts off execution if empty # Old value 0.6
NO_FALLBACK="false"            # true = Panic/fail outright instead of trying higher temperatures
LOG_SCORE="false"              # true = Log final token decoder confidence scores

# === SUPPRESSIONS & GRAMMAR ===
SUPPRESS_NST="true"            # true = Suppress non-speech tokens ([laughter], [sigh], etc.)
SUPPRESS_REGEX=""              # Regular expression matching specific words/tokens to ban
GRAMMAR=""                     # Path to a GBNF grammar file to constrain output format
GRAMMAR_RULE=""                # Top-level entry rule name within the GBNF file
GRAMMAR_PENALTY="100.0"        # Scaler to heavily penalize non-grammar token choices

# === DIARIZATION & TIMESTAMPS ===
DIARIZE="false"                # true = Native stereo audio speaker separation
TINYDIARIZE="false"            # true = Advanced speaker tracking (Requires a tdrz-ready model)
NO_TIMESTAMPS="false"          # true = Strip temporal markers from text layouts
WORD_THOLD="0.01"              # Probability floor threshold for printing a word timestamp
DTW_MODEL=""                   # Path to specialized DTW alignment model for token timestamps

# === VOICE ACTIVITY DETECTION (VAD) ===
USE_VAD="true"                # true = Filter out dead space before running transcription
VAD_MODEL="silero-v6.2.0"      # VAD model variant file key string
VAD_THOLD="0.60"               # Voice probability threshold (0.0 - 1.0) # Old value 0.6
VAD_MIN_SPEECH=100             # Minimum voice window duration threshold in milliseconds
VAD_MIN_SILENCE=100            # Minimum gap window required to cut text segmentation in ms
VAD_MAX_SPEECH=30              # Maximum continuous speech block size allowed in seconds
VAD_PAD=50                     # Front/Back padding buffer in ms appended to speech blocks
VAD_OVERLAP="0.10"             # Audio chunk evaluation overlap percentage window ratio

# === LANGUAGE & PROMPTING ===
LANGUAGE="auto"                # Spoken audio language target ('auto' = detect language)
DETECT_LANGUAGE="false"        # true = Stop and print language identity guess, skip transcribing
INITIAL_PROMPT="Transcribe exactly what is said, including stutters. Technical context. Si la langue change, alors garde la langue en question. Que ce soit en Francais. Oder auf Deutsch, und so weiter."
TRANSLATE="false"              # true = Translate source non-English audio straight to English text

# === CONSOLE PRINTING VISUALS ===
NO_PRINTS="true"               # true = Suppress runtime text dumping to stdout (clean logs)
PRINT_SPECIAL="false"          # true = Print raw structural control tokens to terminal
PRINT_COLORS="true"            # true = Colorize tokens by their model calculation confidence
PRINT_PROGRESS="false"         # true = Output real-time inference completion progress meters

# === EXPORT FORMAT TOGGLES ===
OUTPUT_TXT="false"             # Export standard flat .txt file layout
OUTPUT_VTT="false"             # Export web subtitle .vtt format
OUTPUT_SRT="false"             # Export media container player subtitle .srt format
OUTPUT_LRC="false"              # Export synced lyrics audio player timestamped .lrc layout
OUTPUT_CSV="false"             # Export spreadsheet-friendly structural data comma list format
OUTPUT_JSON="false"            # Export standard base text JSON architecture tree
OUTPUT_JSON_FULL="true"        # Export exhaustive token-metadata nested matrix data structure tree
OUTPUT_WORDS="false"           # Export precise audio tracking script layout for karaoke styling
FONT_PATH=""                   # Absolute path to local system monospace font file for video tracks

# === POST-PROCESSING & CLEANUP ===
COMPRESS_REPETITIONS="true"