# === CORE ===
MODEL="large-v3"
USE_QUANTIZED="true"   # true/false

# === PERFORMANCE ===
THREADS=8
PROCESSORS=1
BEAM_SIZE=5

# === ACCURACY & HALLUCINATION CONTROL ===
ENTROPY_THOLD=2.4      # Lower = Stricter (2.2 - 2.8)
LOGPROB_THOLD=-1.0     # Higher = Stricter (-0.8 - -2.0)
AUDIO_CTX=0            # 0 = Default
SUPPRESS_NST="true"    # Suppress non-speech tokens

# === FORMATTING & OUTPUT ===
LANGUAGE="auto"        # or "en"
TRANSLATE="false"      # Translate to English?
NO_FALLBACK="false"    # true = fail instead of trying lower temps
NO_TIMESTAMPS="false"
TINYDIARIZE="false"    # Speaker separation

# === VISUALS ===
PRINT_COLORS="true"
PRINT_SPECIAL="false"

# === PROMPT ===
INITIAL_PROMPT="Transcribe exactly what is said, including stutters. Technical context."
