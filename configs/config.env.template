# ==============================================================================
# DICTATION HUB DEPLOYMENT CONFIGURATION
# Copy this file to .env and configure it for the local machine.
# ==============================================================================

# --- MACHINE ROLE ---
# Define how this machine operates in the Dictation Hub network.
# Options:
#   'host'   -> Runs Whisper inference locally and can host the FastAPI server.
#   'client' -> Captures audio locally and streams it to the host over the network.
DICTATION_ROLE="host"

# ==============================================================================
# CLIENT SETTINGS (Required if DICTATION_ROLE="client")
# ==============================================================================

# The Tailscale IP or domain of the GPU host running the dictation server.
SERVER_PROTOCOL="http"
SERVER_IP="100.71.x.x"
SERVER_PORT="8000"

# (Optional) Force a specific hardware capture backend.
# If left blank, the client will auto-discover (ffmpeg, arecord, rec, parecord).
# AUDIO_BACKEND="arecord"

# ==============================================================================
# HOST SETTINGS (Required if DICTATION_ROLE="host")
# ==============================================================================

# Absolute path to your compiled whisper.cpp directory.
WHISPER_DIR="~/whisper.cpp"

# The network interface the FastAPI server should bind to when started.
# The server has no authentication, so it binds only the Tailscale interface
# by default ("tailscale"). Use 127.0.0.1 for local-only access.
HOST_BIND_IP="tailscale"
HOST_BIND_PORT="8000"
