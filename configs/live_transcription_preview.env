# configs/live_transcription_preview.env
# --- MODELS ---
MODEL="small"

# --- HARDWARE ---
THREADS=8
PROCESSORS=1

# --- VAD (Voice Activity Detection) ---
# Silero VAD strips silence *before* Whisper processes, massively saving time.
VAD_THOLD="0.6"

# --- ACCURACY & HALLUCINATION CONTROL ---
BEAM_SIZE=5
ENTROPY_THOLD=2.4
LOGPROB_THOLD=-1.0
SUPPRESS_NST="true"

# --- LANGUAGE & FORMATTING ---
# "auto" lets Whisper detect the language dynamically. 
LANGUAGE="auto"         
SAVE_AUDIO="false"