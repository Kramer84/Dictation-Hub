{
  "valid_arguments": [
    "language",
    "model",
    "temperature"
  ],
  "profiles": {
    "standard": {
      "env": "standard.env",
      "env_overrides": {},
      "post_processing": []
    },
    "technical": {
      "env": "standard.env",
      "env_overrides": {
        "MARK_CONFIDENCE": "true",
        "INITIAL_PROMPT": "Ollama, Python, Mistral, LLM, JSON, PyTorch, Probabilities, Epistemic, Engineering, Vikunja, N8N, SiYuan, Prompt, Pipeline, PhD, Research, Reliability, Sensitivity, Tolerancing."
      },
      "post_processing": []
    },
    "mail": {
      "env": "standard.env",
      "env_overrides": {
        "MARK_CONFIDENCE": "true",
        "INITIAL_PROMPT": "Kristof Simady"
      },
      "post_processing": [
        "python3 {repo_root}/post_processing/llm_pipeline.py --mode mail --language '{language}'"
      ]
    },
    "notes": {
      "env": "standard.env",
      "env_overrides": {
        "MARK_CONFIDENCE": "true"
      },
      "post_processing": [
        "python3 {repo_root}/post_processing/llm_pipeline.py --mode notes --language '{language}'"
      ]
    },
    "scheduling": {
      "env": "standard.env",
      "env_overrides": {
        "MARK_CONFIDENCE": "true",
        "INITIAL_PROMPT": "Google Calendar, Task, Meeting, Job Interview, PhD Defense, Anniversary, Monthly, Annual, Daily, Afternoon, Morning"
      },
      "post_processing": [
        "python3 {repo_root}/post_processing/llm_pipeline.py --mode mail --language '{language}'"
      ]
    }
  }
}